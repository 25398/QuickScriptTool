;
; QstVHid.inf — ROOT software device, VHF lower filter
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %ManufacturerName%
CatalogFile = qst_vhid.cat
DriverVer   = 07/25/2026,1.0.0.0
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
QstVHid.sys = 1,,

[Manufacturer]
%ManufacturerName% = Standard,NTamd64

[Standard.NTamd64]
%QstVHid.DeviceDesc% = QstVHid_Device, Root\QSTVHID

[QstVHid_Device.NT]
CopyFiles = Drivers_Dir

[Drivers_Dir]
QstVHid.sys

[QstVHid_Device.NT.HW]
AddReg = QstVHid_HW_AddReg

[QstVHid_HW_AddReg]
HKR,,"LowerFilters",0x00010000,"vhf"

[QstVHid_Device.NT.Services]
AddService = QstVHid,%SPSVCINST_ASSOCSERVICE%, QstVHid_Service_Inst

[QstVHid_Service_Inst]
DisplayName    = %QstVHid.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\QstVHid.sys

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName = "QuickScriptTool"
DiskName = "QST Virtual HID Installation Disk"
QstVHid.DeviceDesc = "QST Virtual HID"
QstVHid.SVCDESC = "QST Virtual HID Driver"
