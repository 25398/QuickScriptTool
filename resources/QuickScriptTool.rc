#include "resource.h"
#include <winver.h>

#ifndef VS_VERSION_INFO
#define VS_VERSION_INFO 1
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,3,3,0
 PRODUCTVERSION 1,3,3,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "QuickScriptTool"
            VALUE "FileDescription", "QuickScriptTool"
            VALUE "FileVersion", "1.3.3.0"
            VALUE "InternalName", "QuickScriptTool"
            VALUE "LegalCopyright", "Copyright (C) QuickScriptTool"
            VALUE "OriginalFilename", "QuickScriptTool.exe"
            VALUE "ProductName", "QuickScriptTool"
            VALUE "ProductVersion", "1.3.3"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_APPICON ICON "app_icon.ico"
IDI_TRAY_RUNNING ICON "tray_running.ico"
IDI_BREAKOUT_PAUSE ICON "breakout_pause.ico"
